# Better Auth: generate with `openssl rand -base64 32`
BETTER_AUTH_SECRET=change-me-to-a-random-string-at-least-32-chars
BETTER_AUTH_URL=http://localhost:3200

# Shared secret for Eve agent <-> Nuxt internal API (memory, linking) and the
# iMessage bridge. Must match everywhere it is used.
INTERNAL_API_SECRET=change-me-to-a-random-string-at-least-32-chars

# Database, required everywhere. compose.local.yaml runs this one locally.
DATABASE_URL=postgresql://agent:agent@127.0.0.1:5433/personal_agent

# Local model: OpenAI-compatible endpoint of the Go inference layer, and the
# context window, which must match llama-server's -c.
INFERENCE_API_URL=http://127.0.0.1:9000/v1
INFERENCE_CONTEXT_TOKENS=131072

# Web search (optional), from https://app.tavily.com
# TAVILY_API_KEY=

# Optional: iMessage through Photon (see ../imessage-bridge)
# IMESSAGE_PROJECT_ID=
# IMESSAGE_PROJECT_SECRET=

# Optional: Gmail through the local MCP server (see ../gmail-mcp)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Optional: canonical URL for SEO (Open Graph, canonical links)
# NUXT_PUBLIC_SITE_URL=https://your-app.example.com
