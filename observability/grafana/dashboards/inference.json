    },
    {
      "id": 17,
      "type": "timeseries",
      "title": "Queue wait and rejections",
      "description": "How long admitted requests waited, and requests turned away.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 31,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(inference_queue_wait_seconds_bucket[$__rate_interval])))",
          "legendFormat": "wait p95",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (reason) (increase(inference_rejected_total[1m]))",
