    },
    {
      "id": 15,
      "type": "row",
      "title": "Admission control",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 30,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 16,
      "type": "timeseries",
      "title": "Queue",
      "description": "Waiting requests are bounded by MAX_QUEUE; in flight by MAX_CONCURRENT.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 31,
        "w": 12,
